# ── Public (safe in the browser and in this repo) ────────────────────────────
NEXT_PUBLIC_OXIBASE_URL=https://oxibase.baltavista.com
NEXT_PUBLIC_OXIBASE_REF=chirp

# The anon key: role "read", signed with the project's key. It is meant to ship
# in a browser — its writes are adjudicated by security rules, and it cannot
# write files, time-series or SQL tables at all.
NEXT_PUBLIC_OXIBASE_ANON_KEY=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJyZWFkQHl3NTBvZnF2N21yYms1eTUiLCJyb2xlIjoicmVhZCIsImlhdCI6MTc4NDkzNTMyNiwiZXhwIjoyMTAwMjk1MzI2fQ.ACu7M1qy2Wxfa0fzE6wDmYbzTj2vlu0eTl3DvA4w2kRPg3VNXqkWrbdEJyJIdoJQxFSf7qbwXSdU5Ha_6o9Zxg

# ── Server only (never NEXT_PUBLIC_, never committed) ───────────────────────
# Used by the route handlers for what a browser key deliberately cannot do:
# write files, append impressions, and change the follow graph (a SQL table).
OXIBASE_SERVICE_KEY=
